# Copiar a .env.local y completar con los valores del proyecto Supabase.
# La clave publicable puede usarse en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para tareas administrativas ejecutadas desde servidor o scripts.
# Nunca usar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=

# Contraseña exclusiva para las cuentas ficticias de demostración.
DEMO_USER_PASSWORD=

# Integraciones de IA (solo servidor; nunca usar NEXT_PUBLIC_ aquí).
# La clave se usará para sugerir la tarea destino de una entrega y para el
# asistente del profesor cuando implementemos esos flujos.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Agente de voz: se usa reconocimiento del navegador y el modelo de IA recibe
# únicamente la transcripción y los datos académicos autorizados por RLS.
