# Copiar a .env.local y completar con los valores del proyecto Supabase.
# La clave publicable puede usarse en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para tareas administrativas ejecutadas desde servidor o scripts.
# Nunca usar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=

# Contraseña exclusiva para las cuentas ficticias de demostración.
DEMO_USER_PASSWORD=
